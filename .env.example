# BDH HRIS - environment configuration
#
# Copy this file to ".env" in the project root and fill in real values.
# ".env" is git-ignored on purpose - never commit real secrets or the
# production database password.
#
# manage.py and serve.py load this file themselves on start (see
# bdh_hris/envfile.py - no python-dotenv dependency, to keep the dependency
# list short). After editing it, restart the service (nssm restart
# BDH-HRIS). A variable already set in the real environment wins over this
# file. See DEPLOYMENT.md.

# --- Django core -------------------------------------------------------

# A long, random, secret string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Keep this the SAME value across restarts/updates - changing it invalidates
# every logged-in session and password-reset link.
BDH_HRIS_SECRET_KEY=

# 0 in production (also the default when this line is missing). Setting it
# to "1" in production would leak stack traces (including settings and
# query details) to anyone who hits an error. Use 1 only on a developer's
# own machine.
BDH_HRIS_DEBUG=0

# Comma-separated hostnames/IPs this server answers to, e.g.:
#   BDH_HRIS_ALLOWED_HOSTS=bdh-hris,bdh-hris.bdh.local,10.20.30.40
BDH_HRIS_ALLOWED_HOSTS=

# Usually leave blank. Only needed if the app sits behind a reverse proxy
# or is reached by a hostname/scheme that wouldn't already match
# BDH_HRIS_ALLOWED_HOSTS (Django's CSRF check needs the exact origin), e.g.:
#   BDH_HRIS_CSRF_TRUSTED_ORIGINS=http://bdh-hris,http://bdh-hris.bdh.local
BDH_HRIS_CSRF_TRUSTED_ORIGINS=

# --- Database (PostgreSQL) ----------------------------------------------
# Leaving BDH_HRIS_DB_NAME blank falls back to a local SQLite file
# (db.sqlite3) - fine for a quick look, NOT for production use with real
# staff data or multiple concurrent users.

BDH_HRIS_DB_NAME=bdh_hris
BDH_HRIS_DB_USER=bdh_hris
BDH_HRIS_DB_PASSWORD=
BDH_HRIS_DB_HOST=localhost
BDH_HRIS_DB_PORT=5432

# --- File storage --------------------------------------------------------

# Where uploaded supporting documents (medical certificates, IDs, etc. -
# CLAUDE.md §10) are stored on disk. These are never served as plain static
# files (see documents/views.document_download) - point this somewhere
# with restricted filesystem permissions, ideally outside the web root.
BDH_HRIS_MEDIA_ROOT=

# --- Policy-derived settings (CLAUDE.md §13) ------------------------------

# Years after separation before a personnel record is due for retention
# review. Confirmed with the project owner as 10 - only change this if that
# policy changes.
BDH_HRIS_RECORD_RETENTION_YEARS=10

# --- Waitress (serve.py) --------------------------------------------------

BDH_HRIS_HOST=0.0.0.0
BDH_HRIS_PORT=8000
BDH_HRIS_THREADS=4

# --- Nightly backup (scripts/backup_db.py) --------------------------------

# Folder the nightly .sql dumps are written to. CLAUDE.md §2: put this on a
# separate drive from the OS/DB drive where the server has one, e.g.:
#   BDH_HRIS_BACKUP_DIR=D:\BDH-HRIS-Backups
BDH_HRIS_BACKUP_DIR=

# Only needed if PostgreSQL's bin folder (containing pg_dump.exe) isn't on
# the system PATH, e.g.:
#   BDH_HRIS_PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
BDH_HRIS_PG_DUMP_PATH=

# --- PDF output for leave forms (LibreOffice) -------------------------------

# Only needed if LibreOffice is installed somewhere unusual. Normally leave
# blank: the app finds soffice.exe on PATH or in C:\Program Files\LibreOffice.
#   BDH_HRIS_LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
BDH_HRIS_LIBREOFFICE_PATH=
